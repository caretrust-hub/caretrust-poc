{
  "$defs": {
    "ClinicalDataDecisionValue": {
      "enum": [
        "permit",
        "deny"
      ],
      "title": "ClinicalDataDecisionValue",
      "type": "string"
    },
    "ClinicalDataReasonCode": {
      "enum": [
        "DATA_HOLDER_POLICY_SATISFIED",
        "PARTICIPANT_NOT_ELIGIBLE",
        "CLIENT_NOT_REGISTERED",
        "AUTHORIZED_USER_NOT_ELIGIBLE",
        "PATIENT_NO_MATCH",
        "CARETRUST_CONTEXT_NOT_ACTIVE",
        "CARETRUST_CONTEXT_REVOKED",
        "CARETRUST_CONTEXT_EXPIRED",
        "INSUFFICIENT_DELEGATED_SCOPE",
        "DATA_HOLDER_POLICY_DENIED"
      ],
      "title": "ClinicalDataReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Final clinical-data disclosure decision made by the data holder.",
  "properties": {
    "authorized_user_ref": {
      "title": "Authorized User Ref",
      "type": "string"
    },
    "caretrust_role": {
      "const": "delegation_and_trust_context_only",
      "title": "Caretrust Role",
      "type": "string"
    },
    "client_id": {
      "title": "Client Id",
      "type": "string"
    },
    "data_holder_id": {
      "title": "Data Holder Id",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ClinicalDataDecisionValue"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "disclosure_policy_authority": {
      "const": "data_holder",
      "title": "Disclosure Policy Authority",
      "type": "string"
    },
    "fhir_bundle_included": {
      "title": "Fhir Bundle Included",
      "type": "boolean"
    },
    "granted_fhir_resource_types": {
      "items": {
        "type": "string"
      },
      "title": "Granted Fhir Resource Types",
      "type": "array"
    },
    "granted_scopes": {
      "items": {
        "type": "string"
      },
      "title": "Granted Scopes",
      "type": "array"
    },
    "participant_org_ref": {
      "title": "Participant Org Ref",
      "type": "string"
    },
    "patient_match_authority": {
      "const": "data_holder",
      "title": "Patient Match Authority",
      "type": "string"
    },
    "patient_match_id": {
      "title": "Patient Match Id",
      "type": "string"
    },
    "policy_version": {
      "const": "synthetic.data-holder.disclosure.v1",
      "title": "Policy Version",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ClinicalDataReasonCode"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "requesting_party_eligibility_authority": {
      "const": "data_holder",
      "title": "Requesting Party Eligibility Authority",
      "type": "string"
    },
    "schema_version": {
      "const": "caretrust.clinical-data-authorization-decision.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "supporting_caretrust_context_ids": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Caretrust Context Ids",
      "type": "array"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "request_id",
    "patient_match_id",
    "data_holder_id",
    "participant_org_ref",
    "authorized_user_ref",
    "client_id",
    "decision",
    "reason_codes",
    "granted_fhir_resource_types",
    "granted_scopes",
    "supporting_caretrust_context_ids",
    "policy_version",
    "patient_match_authority",
    "requesting_party_eligibility_authority",
    "disclosure_policy_authority",
    "caretrust_role",
    "fhir_bundle_included",
    "decided_at",
    "synthetic"
  ],
  "title": "ClinicalDataAuthorizationDecision",
  "type": "object"
}
