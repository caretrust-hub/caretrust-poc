{
  "$defs": {
    "ClaimStatus": {
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "title": "ClaimStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A post-review, post-source-verification claim created outside the model.",
  "properties": {
    "allowed_audiences": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Audiences",
      "type": "array"
    },
    "allowed_purposes": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Purposes",
      "type": "array"
    },
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "claim_type": {
      "const": "professional_credential",
      "title": "Claim Type",
      "type": "string"
    },
    "credential_profile": {
      "const": "hawaii_cna_smoke_v1",
      "title": "Credential Profile",
      "type": "string"
    },
    "credential_type": {
      "const": "Certified Nurse Aide",
      "title": "Credential Type",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer_ref": {
      "title": "Issuer Ref",
      "type": "string"
    },
    "jurisdiction": {
      "const": "HI",
      "title": "Jurisdiction",
      "type": "string"
    },
    "registry_id": {
      "title": "Registry Id",
      "type": "string"
    },
    "registry_result_id": {
      "title": "Registry Result Id",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revoked At"
    },
    "schema_version": {
      "const": "caretrust.active-credential-claim.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ClaimStatus"
    },
    "subject_ref": {
      "title": "Subject Ref",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Valid From"
    },
    "valid_until": {
      "title": "Valid Until",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "claim_id",
    "claim_type",
    "credential_profile",
    "subject_ref",
    "issuer_ref",
    "jurisdiction",
    "registry_id",
    "credential_type",
    "valid_from",
    "valid_until",
    "status",
    "allowed_audiences",
    "allowed_purposes",
    "evidence_refs",
    "review_id",
    "registry_result_id",
    "issued_at"
  ],
  "title": "ActiveCredentialClaim",
  "type": "object"
}
