{
  "$defs": {
    "RevocationTargetType": {
      "enum": [
        "claim",
        "token"
      ],
      "title": "RevocationTargetType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Portable record shape for a local synthetic revocation decision.\n\nPhase 1 exports and validates this contract but does not persist it through a\ndurable or federated status service.",
  "properties": {
    "actor_ref": {
      "title": "Actor Ref",
      "type": "string"
    },
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "reason_code": {
      "enum": [
        "CLAIM_REVOKED",
        "TOKEN_REVOKED"
      ],
      "title": "Reason Code",
      "type": "string"
    },
    "revocation_id": {
      "title": "Revocation Id",
      "type": "string"
    },
    "revoked_at": {
      "format": "date-time",
      "title": "Revoked At",
      "type": "string"
    },
    "schema_version": {
      "const": "caretrust.revocation-record.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "target_type": {
      "$ref": "#/$defs/RevocationTargetType"
    }
  },
  "required": [
    "schema_version",
    "revocation_id",
    "target_type",
    "target_id",
    "claim_id",
    "reason_code",
    "reason",
    "actor_ref",
    "revoked_at",
    "synthetic"
  ],
  "title": "RevocationRecord",
  "type": "object"
}
