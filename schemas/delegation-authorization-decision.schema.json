        "DELEGATE_MISMATCH",
        "AUDIENCE_NOT_ALLOWED",
        "PURPOSE_NOT_ALLOWED",
        "ACTION_NOT_ALLOWED",
        "RESOURCE_NOT_ALLOWED",
        "RESOURCE_EXCLUDED",
        "GRANT_NOT_YET_VALID",
        "GRANT_EXPIRED",
        "GRANT_REVOKED"
      ],
      "title": "DelegationReasonCode",
      "type": "string"
