{
  "$defs": {
    "CareTeamRow": {
      "additionalProperties": false,
      "description": "Administrative relationship row derived from a relationship claim.",
      "properties": {
        "authority_basis": {
          "const": "patient_attestation",
          "title": "Authority Basis",
          "type": "string"
        },
        "caregiver_ref": {
          "title": "Caregiver Ref",
          "type": "string"
        },
        "grant_history": {
          "items": {
            "$ref": "#/$defs/GrantHistoryReference"
          },
          "title": "Grant History",
          "type": "array"
        },
        "legal_authority_status": {
          "const": "not_established",
          "title": "Legal Authority Status",
          "type": "string"
        },
        "patient_ref": {
          "title": "Patient Ref",
          "type": "string"
        },
        "relationship_claim_id": {
          "title": "Relationship Claim Id",
          "type": "string"
        },
        "relationship_code": {
          "title": "Relationship Code",
          "type": "string"
        },
        "relationship_status": {
          "$ref": "#/$defs/GrantStatus"
        },
        "relationship_valid_from": {
          "format": "date",
          "title": "Relationship Valid From",
          "type": "string"
        },
        "relationship_valid_until": {
          "format": "date",
          "title": "Relationship Valid Until",
          "type": "string"
        },
        "role_evidence": {
          "items": {
            "$ref": "#/$defs/ProjectionEvidence"
          },
          "title": "Role Evidence",
          "type": "array"
        },
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "source_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "source_payload_sha256s": {
          "items": {
            "type": "string"
          },
          "title": "Source Payload Sha256S",
          "type": "array"
        }
      },
      "required": [
        "row_id",
        "patient_ref",
        "caregiver_ref",
        "relationship_claim_id",
        "relationship_code",
        "relationship_status",
        "relationship_valid_from",
        "relationship_valid_until",
        "authority_basis",
        "legal_authority_status",
        "grant_history",
        "role_evidence",
        "source_event_ids",
        "source_payload_sha256s"
      ],
      "title": "CareTeamRow",
      "type": "object"
    },
    "CaseHistoryRow": {
      "additionalProperties": false,
      "description": "One source trace event retained in append-only case history.",
      "properties": {
        "actor_ref": {
          "title": "Actor Ref",
          "type": "string"
        },
        "boundary": {
          "title": "Boundary",
          "type": "string"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "message_type": {
          "title": "Message Type",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "receiver_ref": {
          "title": "Receiver Ref",
          "type": "string"
        },
        "record_state": {
          "$ref": "#/$defs/HistoryRecordState"
        },
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "source_event_id": {
          "title": "Source Event Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "source_payload_sha256": {
          "title": "Source Payload Sha256",
          "type": "string"
        },
        "summary_code": {
          "title": "Summary Code",
          "type": "string"
        },
        "superseded_by_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By Event Id"
        },
        "supersedes_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Event Id"
        },
        "trace_sequence": {
          "title": "Trace Sequence",
          "type": "integer"
        }
      },
      "required": [
        "row_id",
        "source_event_id",
        "trace_sequence",
        "occurred_at",
        "actor_ref",
        "receiver_ref",
        "boundary",
        "message_type",
        "summary_code",
        "evidence_status",
        "source_payload_sha256",
        "source_ids",
        "record_state"
      ],
      "title": "CaseHistoryRow",
      "type": "object"
    },
    "DelegationResource": {
      "description": "Resource categories understood by the bounded prototype.",
      "enum": [
        "appointments",
        "visit_instructions",
        "care_team_messages",
        "billing",
        "mental_health_records"
      ],
      "title": "DelegationResource",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "role",
        "purpose",
        "approval",
        "lifecycle"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceStatus": {
      "description": "Bounded evidence classes used across runtime, UI, and documentation.",
      "enum": [
        "retained_aws",
        "executed_local",
        "contract_tested",
        "local_simulation",
        "mapped_only",
        "planned"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "GrantHistoryReference": {
      "additionalProperties": false,
      "description": "One grant's current lifecycle view without erasing its source history.",
      "properties": {
        "grant_event_id": {
          "title": "Grant Event Id",
          "type": "string"
        },
        "grant_id": {
          "title": "Grant Id",
          "type": "string"
        },
        "grant_payload_sha256": {
          "title": "Grant Payload Sha256",
          "type": "string"
        },
        "revocation_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revocation Event Id"
        },
        "revocation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revocation Id"
        },
        "state": {
          "$ref": "#/$defs/NavigatorGrantState"
        },
        "was_ever_active": {
          "title": "Was Ever Active",
          "type": "boolean"
        }
      },
      "required": [
        "grant_id",
        "state",
        "was_ever_active",
        "grant_event_id",
        "grant_payload_sha256"
      ],
      "title": "GrantHistoryReference",
      "type": "object"
    },
    "GrantStatus": {
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "title": "GrantStatus",
      "type": "string"
    },
    "HistoryRecordState": {
      "enum": [
        "current",
        "superseded"
      ],
      "title": "HistoryRecordState",
      "type": "string"
    },
    "NavigatorGrantState": {
      "enum": [
        "active",
        "not_yet_valid",
        "revoked",
        "expired"
      ],
      "title": "NavigatorGrantState",
      "type": "string"
    },
    "NavigatorMetadata": {
      "additionalProperties": false,
      "description": "Projection provenance and the explicit non-chart boundary.",
      "properties": {
        "clinical_chart_status": {
          "const": "not_a_clinical_chart",
          "title": "Clinical Chart Status",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "not_clinical_chart": {
          "const": true,
          "title": "Not Clinical Chart",
          "type": "boolean"
        },
        "patient_ref": {
          "title": "Patient Ref",
          "type": "string"
        },
        "projected_as_of": {
          "format": "date-time",
          "title": "Projected As Of",
          "type": "string"
        },
        "schema_version": {
          "const": "caretrust.navigator-metadata.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "source_trace_id": {
          "title": "Source Trace Id",
          "type": "string"
        },
        "source_trace_sha256": {
          "title": "Source Trace Sha256",
          "type": "string"
        },
        "synthetic_only": {
          "const": true,
          "title": "Synthetic Only",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "source_trace_id",
        "source_trace_sha256",
        "patient_ref",
        "projected_as_of",
        "synthetic_only",
        "not_clinical_chart",
        "clinical_chart_status",
        "source_event_ids",
        "limitations"
      ],
      "title": "NavigatorMetadata",
      "type": "object"
    },
    "PermissionEffect": {
      "enum": [
        "allow",
        "exclude"
      ],
      "title": "PermissionEffect",
      "type": "string"
    },
    "PermissionMatrixRow": {
      "additionalProperties": false,
      "description": "One derived grant permission or explicit exclusion.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Action"
        },
        "approval_id": {
          "title": "Approval Id",
          "type": "string"
        },
        "audiences": {
          "items": {
            "type": "string"
          },
          "title": "Audiences",
          "type": "array"
        },
        "currently_effective": {
          "title": "Currently Effective",
          "type": "boolean"
        },
        "delegate_ref": {
          "title": "Delegate Ref",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/PermissionEffect"
        },
        "grant_id": {
          "title": "Grant Id",
          "type": "string"
        },
        "grant_state": {
          "$ref": "#/$defs/NavigatorGrantState"
        },
        "patient_ref": {
          "title": "Patient Ref",
          "type": "string"
        },
        "purpose_evidence": {
          "items": {
            "$ref": "#/$defs/ProjectionEvidence"
          },
          "title": "Purpose Evidence",
          "type": "array"
        },
        "purposes": {
          "items": {
            "type": "string"
          },
          "title": "Purposes",
          "type": "array"
        },
        "relationship_claim_id": {
          "title": "Relationship Claim Id",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/DelegationResource"
        },
        "role_evidence": {
          "items": {
            "$ref": "#/$defs/ProjectionEvidence"
          },
          "title": "Role Evidence",
          "type": "array"
        },
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "source_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "source_payload_sha256s": {
          "items": {
            "type": "string"
          },
          "title": "Source Payload Sha256S",
          "type": "array"
        }
      },
      "required": [
        "row_id",
        "grant_id",
        "relationship_claim_id",
        "patient_ref",
        "delegate_ref",
        "effect",
        "action",
        "resource",
        "audiences",
        "purposes",
        "grant_state",
        "currently_effective",
        "approval_id",
        "role_evidence",
        "purpose_evidence",
        "source_event_ids",
        "source_payload_sha256s"
      ],
      "title": "PermissionMatrixRow",
      "type": "object"
    },
    "ProjectionEvidence": {
      "additionalProperties": false,
      "description": "Visible pointer from a derived row back to one source message field.",
      "properties": {
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "payload_path": {
          "title": "Payload Path",
          "type": "string"
        },
        "payload_sha256": {
          "title": "Payload Sha256",
          "type": "string"
        },
        "source_event_id": {
          "title": "Source Event Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_message_type": {
          "title": "Source Message Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_event_id",
        "source_message_type",
        "source_id",
        "payload_path",
        "value",
        "payload_sha256",
        "evidence_status"
      ],
      "title": "ProjectionEvidence",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "Stable identifier retained from a trace envelope.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete deterministic view for one synthetic patient case.",
  "properties": {
    "care_team_rows": {
      "items": {
        "$ref": "#/$defs/CareTeamRow"
      },
      "title": "Care Team Rows",
      "type": "array"
    },
    "case_history_rows": {
      "items": {
        "$ref": "#/$defs/CaseHistoryRow"
      },
      "title": "Case History Rows",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/NavigatorMetadata"
    },
    "permission_matrix_rows": {
      "items": {
        "$ref": "#/$defs/PermissionMatrixRow"
      },
      "title": "Permission Matrix Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "caretrust.patient-navigator-projection.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "metadata",
    "care_team_rows",
    "permission_matrix_rows",
    "case_history_rows"
  ],
  "title": "PatientNavigatorProjection",
  "type": "object"
}
