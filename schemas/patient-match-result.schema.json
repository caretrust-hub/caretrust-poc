{
  "$defs": {
    "PatientMatchStatus": {
      "enum": [
        "matched",
        "no_match",
        "not_attempted"
      ],
      "title": "PatientMatchStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Patient-match result owned and produced by the synthetic data holder.",
  "properties": {
    "authority": {
      "const": "data_holder",
      "title": "Authority",
      "type": "string"
    },
    "data_holder_id": {
      "title": "Data Holder Id",
      "type": "string"
    },
    "local_patient_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Patient Ref"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "match_inputs_disclosed_to_caretrust": {
      "const": false,
      "title": "Match Inputs Disclosed To Caretrust",
      "type": "boolean"
    },
    "method": {
      "enum": [
        "synthetic_data_holder_index",
        "not_attempted_requesting_party_gate",
        "not_attempted_caretrust_context_gate"
      ],
      "title": "Method",
      "type": "string"
    },
    "performed_at": {
      "format": "date-time",
      "title": "Performed At",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "caretrust.patient-match-result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/PatientMatchStatus"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "match_id",
    "request_id",
    "data_holder_id",
    "status",
    "method",
    "authority",
    "match_inputs_disclosed_to_caretrust",
    "performed_at",
    "synthetic"
  ],
  "title": "PatientMatchResult",
  "type": "object"
}
