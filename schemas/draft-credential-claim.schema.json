{
  "$defs": {
    "DraftCredentialFields": {
      "additionalProperties": false,
      "description": "Gold fields for the deliberately narrow Hawaii CNA smoke profile.",
      "properties": {
        "credential_status": {
          "$ref": "#/$defs/DraftField"
        },
        "credential_type": {
          "$ref": "#/$defs/DraftField"
        },
        "expiration_date": {
          "$ref": "#/$defs/DraftField"
        },
        "holder_name": {
          "$ref": "#/$defs/DraftField"
        },
        "issuer_or_source": {
          "$ref": "#/$defs/DraftField"
        },
        "jurisdiction": {
          "$ref": "#/$defs/DraftField"
        },
        "original_or_issue_date": {
          "$ref": "#/$defs/DraftField"
        },
        "registry_id": {
          "$ref": "#/$defs/DraftField"
        },
        "restrictions_or_notes": {
          "$ref": "#/$defs/DraftField"
        }
      },
      "required": [
        "holder_name",
        "registry_id",
        "credential_type",
        "jurisdiction",
        "original_or_issue_date",
        "expiration_date",
        "credential_status",
        "restrictions_or_notes",
        "issuer_or_source"
      ],
      "title": "DraftCredentialFields",
      "type": "object"
    },
    "DraftField": {
      "additionalProperties": false,
      "description": "One unverified extracted field with explicit evidence linkage.",
      "properties": {
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "confidence",
        "evidence_refs"
      ],
      "title": "DraftField",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "code": {
          "$ref": "#/$defs/UncertaintyCode"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "field_paths": {
          "items": {
            "type": "string"
          },
          "title": "Field Paths",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "field_paths",
        "message",
        "evidence_refs",
        "blocking"
      ],
      "title": "Uncertainty",
      "type": "object"
    },
    "UncertaintyCode": {
      "enum": [
        "AMBIGUOUS_DATE",
        "MISSING_IDENTIFIER",
        "CROPPED_RESTRICTION",
        "UNSUPPORTED_ISSUER",
        "UNREADABLE_EVIDENCE",
        "CONTRADICTORY_VALUE"
      ],
      "title": "UncertaintyCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The only structured object that an extraction model may propose.",
  "properties": {
    "blocking_issues": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Issues",
      "type": "array"
    },
    "claim_type": {
      "const": "professional_credential",
      "title": "Claim Type",
      "type": "string"
    },
    "credential_profile": {
      "const": "hawaii_cna_smoke_v1",
      "title": "Credential Profile",
      "type": "string"
    },
    "draft_id": {
      "title": "Draft Id",
      "type": "string"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "fields": {
      "$ref": "#/$defs/DraftCredentialFields"
    },
    "schema_version": {
      "const": "caretrust.draft-credential-claim.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "draft",
      "title": "Status",
      "type": "string"
    },
    "subject_ref": {
      "title": "Subject Ref",
      "type": "string"
    },
    "uncertainties": {
      "items": {
        "$ref": "#/$defs/Uncertainty"
      },
      "title": "Uncertainties",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "draft_id",
    "evidence_id",
    "subject_ref",
    "claim_type",
    "credential_profile",
    "status",
    "fields",
    "uncertainties",
    "blocking_issues"
  ],
  "title": "DraftCredentialClaim",
  "type": "object"
}
