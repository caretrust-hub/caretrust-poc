CARETRUST_BEDROCK_MODEL_ID=qwen.qwen3-32b-v1:0
CARETRUST_BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
CARETRUST_INFERENCE_BUDGET_USD=10.00
CARETRUST_DATA_DIR=./var
CARETRUST_LOG_LEVEL=INFO
